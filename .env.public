# huggingface configs
HF_TOKEN=...

# reproducible ranking
REPRODUCIBLE_RANKING=1
# https://docs.nvidia.com/cuda/cublas/index.html#results-reproducibility
CUBLAS_WORKSPACE_CONFIG=:4096:8
# https://docs.vllm.ai/en/v0.8.5.post1/getting_started/examples/reproduciblity.html
VLLM_ENABLE_V1_MULTIPROCESSING=0
SEED=1122

# vllm logging configuration
# https://docs.vllm.ai/en/v0.7.2/getting_started/examples/logging_configuration.html
VLLM_CONFIGURE_LOGGING=0

# OpenAI API
OPENAI_API_KEY=...

# Azure OpenAI API 
AZURE_API_KEY=...
AZURE_API_BASE=...

# Anthropic API
ANTHROPIC_API_KEY=...

# litellm
# workaround for 'Unclosed client session' error with acompletion
# solution source: https://github.com/BerriAI/litellm/issues/11657
DISABLE_AIOHTTP_TRANSPORT=True